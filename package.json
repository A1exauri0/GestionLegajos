{
    "name": "gestion-legajos",
    "version": "1.0.0",
    "description": "Sistema de Gestión y Auditoría de Legajos con Electron y SQLite",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "pack": "electron-builder --dir",
        "dist": "electron-builder"
    },
    "dependencies": {
        "better-sqlite3": "^11.8.1",
        "exceljs": "^4.4.0"
    },
    "devDependencies": {
        "electron": "^33.2.0",
        "electron-builder": "^25.1.8"
    },
    "build": {
        "appId": "com.stellum.gestionlegajos",
        "productName": "Gestion de Legajos",
        "win": {
            "target": "portable"
        },
        "directories": {
            "output": "dist"
        }
    }
}